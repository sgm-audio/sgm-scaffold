[package]
name = "{{ crate_name }}"
version = "0.1.0"
edition = "{{ edition }}"
license = "{{ license }}"
repository = "{{ repo_url }}/{{ project_name }}"
description = "{{ description }}"

[lib]
path = "shared/src/lib.rs"
crate-type = ["cdylib", "staticlib"]

[dependencies]

[profile.release]
opt-level = 3
lto = "thin"