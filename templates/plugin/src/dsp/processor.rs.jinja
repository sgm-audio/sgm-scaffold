    pub fn process(&mut self, buffer: &mut Buffer, params: &std::sync::Arc<{{ struct_name }}Params>) {
        // Read smoothed parameter values once per buffer (RT-safe atomic reads)
        let gain_db = params.gain.value();
        let mix = params.mix.value();

        // Convert dB to linear once per buffer
        let gain = 10.0_f32.powf(gain_db / 20.0);

        for mut channel_samples in buffer.iter_samples() {
            for sample in channel_samples.iter_mut() {
                // Denormal protection: flush tiny subnormals to zero
                if sample.abs() < 1e-20_f32 {
                    *sample = 0.0;
                }

                // Apply gain
                let processed = *sample * gain;

                // Dry/wet mix
                *sample = *sample * (1.0 - mix) + processed * mix;

                // Clamp to prevent overflow
                *sample = processed.clamp(-1.0, 1.0);
            }
        }
    }

