use approx::assert_relative_eq;
use {{ crate_name }}::dsp::processor::{{ struct_name }}Processor;
use {{ crate_name }}::{{ struct_name }};
use {{ crate_name }}::params::{{ struct_name }}Params;

#[test]
fn unity_gain_passthrough() {
    // With 0 dB gain and 100% mix, output should equal input
    let params = {{ struct_name }}Params::default();
    assert_relative_eq!(params.gain.value(), 0.0, epsilon = 1e-6);
    assert_relative_eq!(params.mix.value(), 100.0, epsilon = 1e-6);
}

#[test]
fn zero_gain_silence() {
    // -24 dB = ~0.063 linear
    assert_relative_eq!(10.0_f32.powf(-24.0 / 20.0), 0.063, epsilon = 0.01);
}

#[test]
fn mix_range() {
    // Mix should be 0-100%
    let params = {{ struct_name }}Params::default();
    assert!(params.mix.value() >= 0.0);
    assert!(params.mix.value() <= 100.0);
}

#[test]
fn params_finite() {
    let params = {{ struct_name }}Params::default();
    assert!(params.gain.value().is_finite());
    assert!(params.mix.value().is_finite());
}

