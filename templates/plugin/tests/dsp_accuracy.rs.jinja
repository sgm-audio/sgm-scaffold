fn processor_default_valid() {
    // Processor must construct without panic
    let _processor = {{ struct_name }}::default();
}

#[test]
fn processor_reset_valid() {
    // Reset must not panic
    let mut processor = {{ struct_name }}Processor::default();
    processor.reset();
}